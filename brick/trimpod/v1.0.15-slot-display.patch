+/* Startup errors must go to the log. Rockbox's on-screen panic needs the
+ * window and LCD surface that this code is still setting up. */
+static bool try_gl_window(int width, int height, Uint32 flags,
+                          int gles_version, int alpha_bits)
+{
+    const char *stage = "SDL_CreateWindow";
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, gles_version);
+    SDL_GL_SetAttribute(SDL_GL_ALPHA_SIZE, alpha_bits);
+    sdlWindow = SDL_CreateWindow(UI_TITLE, SDL_WINDOWPOS_CENTERED,
+                                 SDL_WINDOWPOS_CENTERED, width, height, flags);
+    if (sdlWindow)
+    {
+        stage = "SDL_GL_CreateContext";
+        gl_ctx = SDL_GL_CreateContext(sdlWindow);
+        if (gl_ctx)
+        {
+            stage = "SDL_GL_MakeCurrent";
+            if (SDL_GL_MakeCurrent(sdlWindow, gl_ctx) == 0)
+                return true;
+        }
+    }
+
+    fprintf(stderr, "Trimpod display (%s, %dx%d, ES%d, alpha %d): %s: %s\n",
+            SDL_GetCurrentVideoDriver(), width, height, gles_version, alpha_bits,
+            stage, SDL_GetError());
+    if (gl_ctx)
+        SDL_GL_DeleteContext(gl_ctx);
+    if (sdlWindow)
+        SDL_DestroyWindow(sdlWindow);
+    gl_ctx = NULL;
+    sdlWindow = NULL;
+    return false;
+}
